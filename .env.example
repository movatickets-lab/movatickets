# --- Banco (Railway injeta DATABASE_URL ao adicionar o plugin MySQL) ---
DATABASE_URL=mysql://user:pass@host:3306/railway
# --- Aplicação ---
APP_PUBLIC_ORIGIN=https://seu-app.up.railway.app
SESSION_SECRET=gere-com-openssl-rand-base64-48
ENCRYPTION_KEY=gere-com-openssl-rand-base64-32
SUPER_ADMIN_EMAILS=voce@exemplo.com
# --- Google OAuth (cliente Web; redirect: APP_PUBLIC_ORIGIN/api/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- Brevo (e-mail transacional) ---
BREVO_API_KEY=
MAIL_FROM_EMAIL=nao-responda@seudominio.com
MAIL_FROM_NAME=MOVA TICKETS
# --- Cloudflare R2 (S3 compatível) ---
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=mova-tickets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.seudominio.com
