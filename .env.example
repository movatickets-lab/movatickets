# --- Banco (Railway injeta DATABASE_URL ao adicionar o plugin MySQL) ---
DATABASE_URL=mysql://usuario:sua_senha_aqui@host:porta/defaultdb?ssl-mode=REQUIRED
# --- Aplicação ---
APP_PUBLIC_ORIGIN=https://movatickets.vercel.app
SESSION_SECRET=mova-tickets-super-secure-session-secret-key-2026-xyz
ENCRYPTION_KEY=mova2026encryptionkeysecurepassw
SUPER_ADMIN_EMAILS=movatickets@gmail.com
# --- Google OAuth (cliente Web; redirect: APP_PUBLIC_ORIGIN/api/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- Brevo (e-mail transacional) ---
BREVO_API_KEY=
MAIL_FROM_EMAIL=suporte.movatickets@gmail.com
MAIL_FROM_NAME=MOVA TICKETS
# --- Cloudflare R2 (S3 compatível) ---
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=mova-tickets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.seudominio.com
